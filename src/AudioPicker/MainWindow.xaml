<Window x:Class="AudioPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioPicker — Windows audio router"
        Width="920" Height="640" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <!-- equalizer icon, animates while running -->
    <Canvas x:Key="EqIcon" Width="22" Height="22" />
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header -->
    <Grid Grid.Row="0" Margin="4,0,4,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}"
                VerticalAlignment="Center">
          <TextBlock Text="♪" FontSize="17" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource HeaderTitle}" Text="AudioPicker" />
          <TextBlock Text="звук приложения → кабель → Discord" FontSize="11"
                     Foreground="{StaticResource SubTextBrush}" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StateBadge" Grid.Column="1" Text="idle" HorizontalAlignment="Right"
                 VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
    </Grid>

    <!-- middle: sources + output -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource CardTitle}"
                     Text="ИСТОЧНИКИ — ctrl/shift для нескольких; 🔊 = играет прямо сейчас" />
          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}"
                     TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="обновить"
                    Margin="8,0,0,0" Click="Refresh_Click" />
          </Grid>
          <ListBox x:Name="SourceList" Grid.Row="2" Style="{StaticResource SourceList}"
                   SelectionMode="Extended"
                   MouseDoubleClick="SourceList_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="dot" Text="●" FontSize="9" Margin="0,1,8,0"
                             Foreground="#3a4157" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="dot" Property="Foreground" Value="{StaticResource GreenBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="ВЫВОД" />
            <ComboBox x:Name="OutCombo" Style="{StaticResource DarkCombo}"
                      SelectionChanged="OutCombo_Changed" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="ГРОМКОСТЬ ПОТОКА (для неё)" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="GainSlider" Style="{StaticResource AccentSlider}"
                      Minimum="0.1" Maximum="4" Value="1"
                      ValueChanged="GainSlider_ValueChanged" />
              <TextBlock x:Name="GainLabel" Grid.Column="1" Text="x1.00"
                         Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <CheckBox x:Name="MonitorCheck" Style="{StaticResource CheckText}"
                      Content="слушать самому (в своих наушниках)" Margin="0,12,0,0"
                      Checked="Monitor_Changed" Unchecked="Monitor_Changed" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="УРОВЕНЬ ВЫХОДА" />
            <ProgressBar x:Name="OutMeter" Style="{StaticResource BigMeter}" Value="0" />
            <TextBlock x:Name="StatusText" Text="выбери источник и жми старт"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,0"
                       TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- transport -->
    <Grid Grid.Row="2" Margin="4,14,4,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="StartBtn" Style="{StaticResource BigStartButton}" Content="▶  СТАРТ"
              Click="Start_Click" MinWidth="150" />
      <TextBlock x:Name="HintText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource SubTextBrush}" FontSize="12"
                 Text="двойной клик по источнику = сразу старт" />
    </Grid>

    <!-- live panel -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,6"
                   Text="КТО ИГРАЕТ ЗВУК СЕЙЧАС — клик по имени = выбрать источником" />
        <ItemsControl x:Name="LivePanel">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="cell" Background="#1b2334" CornerRadius="8" Padding="8,6"
                      Margin="0,0,8,6" Cursor="Hand" MouseLeftButtonUp="LiveCell_Click"
                      Tag="{Binding Name}">
                <StackPanel Width="170">
                  <TextBlock Text="{Binding Display}" FontSize="11"
                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Style="{StaticResource MiniMeter}" Value="{Binding Level}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
                  <Setter TargetName="cell" Property="Background" Value="#2e3652" />
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</Window>
